# Tienda Shopify donde Dropi publica los productos
SHOPIFY_STORE_DOMAIN=gm-27198.myshopify.com
# Token PUBLICO de Storefront API (canal Headless o app con permisos de Storefront)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-07
# Busqueda de Shopify que define que productos se venden en este sitio
SHOPIFY_PRODUCT_QUERY=vendor:Aibimy AND product_type:Parlantes
SHOPIFY_REVALIDATE_SECONDS=300
# En produccion el checkout esta apagado salvo que esto sea "true" (en desarrollo siempre funciona)
NEXT_PUBLIC_CHECKOUT_ENABLED=false
# Pago contra entrega: "true" cuando la tienda propia lo tenga activo (Dropi cobra al entregar).
# En desarrollo siempre se muestra. Los pedidos se crean con la Admin API de Shopify (permiso write_orders).
NEXT_PUBLIC_COD_ENABLED=false
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Interruptor explicito para crear pedidos reales contra entrega (tambien en desarrollo). Solo "true" con la tienda propia.
COD_ORDERS_ENABLED=false
SHOPIFY_ADMIN_API_VERSION=2025-07
# Costo de envío contra entrega en COP; vacío o 0 = "te lo confirmamos" y no se suma al pedido
NEXT_PUBLIC_COD_SHIPPING_FEE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vendedor: quien cobra y factura. Se muestran en las páginas legales y deben ser los del
# dueño de la tienda Shopify conectada. Si falta alguno, las páginas legales salen como borrador.
SELLER_STORE_NAME=Luzunido
SELLER_LEGAL_NAME=
SELLER_TAX_ID=
SELLER_EMAIL=
SELLER_WHATSAPP=
SELLER_CITY=
SELLER_ADDRESS=
# Tiempo de entrega que ve el cliente, por ejemplo: entre 2 y 6 días hábiles
SELLER_SHIPPING_TIME=
# Fecha desde la que rigen las politicas, por ejemplo: 1 de noviembre de 2026
SELLER_POLICY_DATE=
