# Tienda Shopify donde Dropi publica los productos
SHOPIFY_STORE_DOMAIN=gm-27198.myshopify.com
# Token PUBLICO de Storefront API (canal Headless o app con permisos de Storefront)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-07
# Busqueda de Shopify que define que productos se venden en este sitio
SHOPIFY_PRODUCT_QUERY=vendor:Aibimy AND product_type:Parlantes
SHOPIFY_REVALIDATE_SECONDS=300
NEXT_PUBLIC_SITE_URL=http://localhost:3000
